 x="1440" y="520" width="430" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;font-size:13px&quot;&gt;Cómo leerlo&lt;/b&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#9AA4B2;strokeColor=#9AA4B2;fillColor=#FFFFFF;strokeWidth=2;dashed=0;dashPattern=8 6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1880" height="150" as="geometry"/></mxCell><mxCell id="c18" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="982" width="1" height="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="982" width="1" height="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=ERmandOne;startArrow=ERmany;html=1;strokeColor=#232F3E;strokeWidth=1.8;startSize=12;endSize=12;endFill=0;startFill=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="FK real dentro de la misma base: &lt;b&gt;muchos&lt;/b&gt; (pata de gallo) a &lt;b&gt;uno&lt;/b&gt; (raya)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="210" y="970" width="620" height="30" as="geometry"/></mxCell><mxCell id="c22" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1028" width="1" height="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="1028" width="1" height="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=ERmandOne;startArrow=ERzeroToMany;html=1;strokeColor=#8A94A3;strokeWidth=1.5;dashed=1;dashPattern=6 4;startSize=12;endSiz