ncia de cmdb-changes-q.&lt;br&gt;&lt;b&gt;Baja lógica&lt;/b&gt;: DELETE /cis/{id} pone status = retired (otros servicios guardan ci_id y no hay FK entre bases)." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#9C8A2E;fillColor=#FFF8E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1440" y="525" width="430" height="92" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:13px&quot;&gt;Cómo leerlo&lt;/b&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#9AA4B2;strokeColor=#9AA4B2;fillColor=#FFFFFF;strokeWidth=2;dashed=0;dashPattern=8 6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1880" height="150" as="geometry"/></mxCell><mxCell id="c21" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1072" width="1" height="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="1072" width="1" height="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=ERmandOne;startArrow=ERmany;html=1;strokeColor=#232F3E;strokeWidth=1.8;startSize=12;endSize=12;endFill=0;startFill=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="FK real dentro de la misma base: &lt;b&gt;muchos&lt;/b&gt; (pata de gallo) a &lt;b&gt;uno&lt;/b&gt; (raya)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="210" y="1060" width="620" height="30" as="geometry"/></mxCell><mxCell id="c25" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1118" width="1" height="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="1118" width="1" height="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="endArrow=ERmandOne;startArrow=ERzeroToMany;html=1;strokeColor=#8A94A3;strokeWidth=1.5;dashed=1;dashPattern=6 4;startSize=12;endSize=12;endFill=0;startFill=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="Referencia lógica a otro microservicio (caja gris): guarda el UUID, &lt;b&gt;no hay FK&lt;/b&gt; entre bases; la consistencia la dan la API y los eventos" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="210" y="1100" width="640" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;PK&lt;/b&gt; clave primaria · &lt;b&gt;FK&lt;/b&gt; clave foránea · &lt;b&gt;UQ&lt;/b&gt; valor único · &lt;b&gt;ref&lt;/b&gt; referencia lógica · &lt;b&gt;enum&lt;/b&gt; valores fijos (CHECK) · &lt;b&gt;json&lt;/b&gt; columna JSONB: se muestra su estructura, no es una tabla&lt;br&gt;Relaciones: 1 ci_type → N CIs · 1 CI → N relaciones como origen y N como destino (depends_on · runs_on · connects_to) · 1 CI → N cambios en ci_history" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="880" y="1058" width="1000" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="E-R incidents" id="E-R incidents"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1260" background="#FFFFFF" math="0" shadow="0"><root><