alores fijos (CHECK) · &lt;b&gt;json&lt;/b&gt; columna JSONB: se muestra su estructura, no es una tabla&lt;br&gt;Relaciones: 1 problema → 0..N incidentes vinculados · 1 problema → 0..1 error conocido · 1 problema → 0..N tareas · se cierra al implementarse el cambio que lo corrige" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="880" y="1128" width="1000" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="E-R changes" id="E-R changes"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1240" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="ServiDesk — Diagrama E/R · ms-changes (db_changes)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1500" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Mismas tablas en cada schema de tenant (tenant_andina · tenant_pacifico · tenant_unitec): patrón 2 de multi-tenancy en la instancia única de RDS." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#5F6B7A;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1800" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:17px&quot;&gt;PostgreSQL 16 · db_changes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;dueño: ms-changes (Python 3.12 · AWS Lambda · pg8000)&lt;/span&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#2E7D32;strokeColor=#2