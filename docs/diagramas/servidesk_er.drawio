ry"/></mxCell><mxCell id="c26" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1198" width="1" height="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="1198" width="1" height="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=ERmandOne;startArrow=ERzeroToMany;html=1;strokeColor=#8A94A3;strokeWidth=1.5;dashed=1;dashPattern=6 4;startSize=12;endSize=12;endFill=0;startFill=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Referencia lógica a otro microservicio (caja gris): guarda el UUID, &lt;b&gt;no hay FK&lt;/b&gt; entre bases; la consistencia la dan la API y los eventos" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="210" y="1180" width="640" height="46" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;PK&lt;/b&gt; clave primaria · &lt;b&gt;FK&lt;/b&gt; clave foránea · &lt;b&gt;UQ&lt;/b&gt; valor único · &lt;b&gt;ref&lt;/b&gt; referencia lógica · &lt;b&gt;enum&lt;/b&gt; valores fijos (CHECK) · &lt;b&gt;json&lt;/b&gt; columna JSONB: se muestra su estructura, no es una tabla&lt;br&gt;Relaciones: 1 sla_policy → N incidentes · 1 incidente → 0..N comentarios · 1 incidente → 0..N cambios de estado · reportante, asignado y autor son usuarios de ms-identity" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="880" y="1138" width="1000" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="E-R problems" id="E-R problems"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" con