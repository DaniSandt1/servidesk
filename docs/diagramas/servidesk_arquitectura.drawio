<mxfile host="drawio" agent="servidesk/build_diagrams.py"><diagram name="Arquitectura" id="Arquitectura"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="ServiDesk — Diagrama de Arquitectura de Solución (AWS)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="36" as="geometry"/></mxCell><mxCell id="c2" value="SaaS de gestión de servicios TI (ITSM) · multi-tenant (un schema por tenant) · 100 % serverless · basado en eventos (SNS → SQS)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#5F6B7A;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1700" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;Navegador web&lt;br&gt;andina · pacifico · unitec&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=top;spacingTop=44;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="190" height="100" as="geometry"/></mxCell><mxCell id="c4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="110.0" y="178" width="30" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;Equipo / desarrollador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;Repo GitHub al3xi3w/servidesk&lt;br&gt;npm run deploy&lt;br&gt;scripts/*.py · seed/*.py&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=top;spacingTop=44;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="190" height="126" as="geometry"/></mxCell><mxCell id="c6" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="110.0" y="648" width="30" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:13px&quot;&gt;AWS Cloud — región us-east-1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;AWS Academy Learner Lab · rol LabRole&lt;/span&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#232F3E;strokeColor=#232F3E;fillColor=#FFFFFF;strokeWidth=2;dashed=0;dashPattern=8 6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="2120" height="1480" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;AWS Amplify Hosting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;Frontend React 19 + Vite (SPA)&lt;br&gt;app servidesk · rama main&lt;br&gt;publicado con deploy_frontend.py&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#DD344C;fillColor=#FDECEF;strokeWidth=2;align=center;verticalAlign=top;spacingTop=44;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="250" height="116" as="geometry"/></mxCell><mxCell id="c9" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.amplify;" vertex="1" parent="1"><mxGeometry x="410.0" y="168" width="30" height="30" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;6 HTTP API · HTTPS · CORS&lt;br&gt;una por microservicio&lt;br&gt;&lt;br&gt;identity  /auth/login · /auth/me&lt;br&gt;/users · /teams · /notifications&lt;br&gt;cmdb  /cis · /ci-types&lt;br&gt;incidents  /incidents/{id}/…&lt;br&gt;problems  /problems/{id}/…&lt;br&gt;changes  /changes/{id}/approve…&lt;br&gt;requests  /catalog · /requests&lt;br&gt;&lt;br&gt;43 rutas con authorizer JWT&lt;br&gt;+ POST /auth/login pública&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#E7157B;fillColor=#FDEAF3;strokeWidth=2;align=center;verticalAlign=top;spacingTop=44;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="250" height="420" as="geometry"/></mxCell><mxCell id="c11" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="410.0" y="368" width="30" height="30" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;Lambda Authorizer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;JWT HS256 · respuesta simple&lt;br&gt;valida firma, exp y claims&lt;br&gt;contexto: tenant_id · schema ·&lt;br&gt;role · user_id (caché 300 s)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFF4EA;strokeWidth=2;align=center;verticalAlign=top;spacingTop=44;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="830" width="250" height="140" as="geometry"/></mxCell><mxCell id="c13" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="410.0" y="838" width="30" height="30" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:13px&quot;&gt;Seguridad y multi-tenancy&lt;/b&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#7D8998;strokeColor=#7D8998;fillColor=#FFFFFF;strokeWidth=2;dashed=0;dashPattern=8 6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="250" height="230" as="geometry"/></mxCell><mxCell id="c15" value="• El tenant y el schema salen solo del JWT firmado; el backend rechaza tenant_id en el body.&lt;br&gt;• Datos de otro tenant responden 404.&lt;br&gt;• Contraseñas PBKDF2-SHA256 (310 000 iteraciones).&lt;br&gt;• RDS con SSL; secretos solo en variables de entorno." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="310" y="1040" width="236" height="196" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:13px&quot;&gt;Microservicios — AWS Lambda (Python 3.12)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;6 servicios · 57 funciones (rutas HTTP, consumidores SQS y migrate) · cada uno con su propia base&lt;/span&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#ED7100;strokeColor=#ED7100;fillColor=#FFF4EA;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;verticalAlign=top;spacingLeft=48;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="710" height="790" as="geometry"/></mxCell><mxCell id="c17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="612" y="161" width="26" height="26" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;ms-identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;login JWT (PBKDF2) · usuarios · equipos&lt;br&gt;bandeja de notificaciones&lt;br&gt;consume identity-notify-q&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="625" y="230" width="320" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;ms-cmdb&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;CIs · relaciones · historial&lt;br&gt;publica CIStatusChanged&lt;br&gt;consume cmdb-changes-q&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="230" width="320" height="150" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;ms-incidents&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;incidentes · SLA · comentarios&lt;br&gt;consume incidents-ci-q,&lt;br&gt;incidents-problem-q, incidents-kedb-q&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="625" y="415" width="320" height="150" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;ms-problems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;problemas · errores conocidos (KEDB)&lt;br&gt;consume problems-incidents-q,&lt;br&gt;problems-changes-q&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="415" width="320" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;ms-changes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;RFC · aprobación CAB · calendario&lt;br&gt;publica ChangeSubmitted / Approved /&lt;br&gt;Rejected / Implemented&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="625" y="600" width="320" height="150" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;ms-requests&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;catálogo con form_schema&lt;br&gt;solicitudes y aprobaciones&lt;br&gt;publica Request*&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="600" width="320" height="150" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&quot;font-size:14px;color:#232F3E&quot;&gt;Lambda Layer common&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;pg8000 1.31 · scramp 1.4.5 · PyJWT&lt;br&gt;common.db: conexión SSL + SET search_path = schema del tenant&lt;br&gt;common.events: publish(eventType, tenantId, data)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#ED7100;fillColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="625" y="805" width="665" height="105" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;font-size:13px&quot;&gt;Amazon RDS · PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;instancia única servidesk-dev · db.t3.micro · SSL obligatorio&lt;/span&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#3B48CC;strokeColor=#3B48CC;fillColor=#F8F9FE;strokeWidth=2;dashed=0;dashPattern=8 6;align=left;verticalAlign=top;spacingLeft=48;spacingTop=8;container=0;" vertex="1" parent="1"><mxGeometry x="1370" y="150" width="540" height="600" as="geometry"/></mxCell><mxCell id="c26" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3B48CC;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1"><mxGeometry x="1382" y="161" width="26" height="26" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;font-size:13px;color:#232F3E&quot;&gt;db_identity&lt;/b&gt;&lt;span style=&quot;font-size:11px;color:#5F6B7A&quot;&gt;  ·  dueño: ms-identity&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#3B48CC&quot;&gt;tenant_andina │ tenant_pacifico │ tenant_unitec&lt;/span&gt;&lt;span style=&quot;font-size:11px;color:#3B48CC&quot;&gt; │ public.tenants&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#3B48CC;fillColor=#EEF0FC;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=